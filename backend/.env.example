# Copie este arquivo para backend/.env e preencha com os seus dados.
# NUNCA faça commit do arquivo .env.

# Conexão com o MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=enahub_app
DB_PASSWORD=troque-esta-senha
DB_NAME=enahub
# Banco usado pelos testes automatizados (é APAGADO a cada execução; precisa terminar com _test)
DB_NAME_TEST=enahub_test

# Servidor
PORT=3000
# Endereço do front-end (CORS e link de recuperação de senha)
FRONTEND_URL=http://localhost:5173
# development | production | test
NODE_ENV=development
